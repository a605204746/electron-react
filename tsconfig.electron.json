{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["electron-vite/node"],
    "outDir": "out",
    "paths": {
      "@shared/*": ["./shared/*"],
      "@main/*":   ["./electron/*"]
    }
  },
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "shared/**/*"
  ]
}
